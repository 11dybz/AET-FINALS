# Copy to .env and fill in values from Supabase > Connect > Session pooler.
# Copy the real host and username. Do not use these placeholders literally.
# Keep credentials separate from the JDBC URL.
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=
# This file is parsed as Java properties: no surrounding quotes or export prefix.
# Backslashes in a password must be doubled (or use an OS environment variable).
